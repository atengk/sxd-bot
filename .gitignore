# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Local user configuration containing sensitive tokens
config/config.json
.env

# Capture files and logs
*.pcap
*.pcapng
*.log

# Local SQLite databases (data/protocol_manifest.db is tracked as read-only manifest)
data/*.db
!data/protocol_manifest.db
*.sqlite
*.sqlite3
